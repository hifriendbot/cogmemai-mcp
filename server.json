{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.hifriendbot/cogmemai",
  "description": "Persistent cloud memory for Ai coding assistants. 29 MCP tools. Encrypted at rest.",
  "repository": {
    "url": "https://github.com/hifriendbot/cogmemai-mcp",
    "source": "github"
  },
  "version": "3.10.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "cogmemai-mcp",
      "version": "3.10.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "Your CogmemAi API key from hifriendbot.com/developer/",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "COGMEMAI_API_KEY"
        }
      ]
    },
    {
      "registryType": "npm",
      "identifier": "cogmemai-mcp",
      "version": "3.10.0",
      "transport": {
        "type": "streamable-http",
        "url": "https://hifriendbot.com/mcp/"
      }
    }
  ]
}
